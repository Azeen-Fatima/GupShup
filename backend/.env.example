# Server
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:4200

# Database (PostgreSQL - Supabase Session Pooler)
DATABASE_URL=
PRISMA_LOG_QUERIES=false

# Redis (Upstash rediss:// URL)
REDIS_URL=

# Authentication (JWT)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth
GOOGLE_CLIENT_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@gupshup.chat

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP Settings
OTP_TTL_SECONDS=600
