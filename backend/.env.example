# Server
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:4200
CLIENT_ORIGINS=

# Cookies
COOKIE_SAMESITE=lax

# Database (PostgreSQL - Supabase Session Pooler)
DATABASE_URL=
PRISMA_LOG_QUERIES=false

# Redis (Upstash rediss:// URL)
REDIS_URL=

# Authentication (JWT)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth
GOOGLE_CLIENT_ID=

# Email (Resend HTTP API - Primary on Render)
RESEND_API_KEY=
MAIL_FROM=Gupshup <onboarding@resend.dev>

# Email (Fallback SMTP - Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP Settings
OTP_TTL_SECONDS=600
