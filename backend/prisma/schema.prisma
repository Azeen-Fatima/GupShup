generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  name         String
  passwordHash String?
  googleId     String?   @unique
  avatarUrl       String?
  bio             String?
  statusMessage   String?
  themePreference String    @default("system")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  conversationsInitiated Conversation[]   @relation("ConversationRequester")
  conversationsAsUserA   Conversation[]   @relation("ConversationUserA")
  conversationsAsUserB   Conversation[]   @relation("ConversationUserB")
  conversationMembers    ConversationMember[]
  messagesSent           Message[]
  blocksInitiated        Block[]          @relation("Blocker")
  blocksReceived         Block[]          @relation("Blocked")
  refreshTokens          RefreshToken[]

  @@index([email])
  @@index([username])
}

model Conversation {
  id            String    @id @default(uuid())
  userAId       String
  userBId       String
  requesterId   String
  status        String    @default("pending") // pending | accepted | declined | blocked
  declineCount  Int       @default(0)
  declinedAt    DateTime?
  blockedAt     DateTime?
  blockedById   String?
  wasAccepted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?

  userA     User                 @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User                 @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  requester User                 @relation("ConversationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  members   ConversationMember[]
  messages  Message[]

  @@unique([userAId, userBId])
  @@index([lastMessageAt])
  @@index([userAId])
  @@index([userBId])
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  clearedAt      DateTime?
  hiddenAt       DateTime?
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  type           String    @default("text") // text | image | file
  body           String?
  attachmentUrl  String?
  attachmentName String?
  attachmentSize String?
  attachmentMime String?
  clientId       String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  seenAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}
